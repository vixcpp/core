@PACKAGE_INIT@

if (@VIX_CORE_USE_UMBRELLA_TARGETS@)
  include("${CMAKE_CURRENT_LIST_DIR}/../Vix/VixConfig.cmake")

  if (NOT TARGET vix::core)
    message(FATAL_ERROR
      "The umbrella Vix package did not export the vix::core target."
    )
  endif()

  check_required_components(vix_core)
  return()
endif()

include(CMakeFindDependencyMacro)

find_dependency(vix_utils CONFIG REQUIRED)
find_dependency(async CONFIG REQUIRED)
find_dependency(vix_env CONFIG REQUIRED)
find_dependency(vix_io CONFIG REQUIRED)

if (@VIX_CORE_PACKAGE_WITH_OPENSSL@)
  find_dependency(OpenSSL REQUIRED)
endif()

if (@VIX_CORE_PACKAGE_WITH_JSON@)
  find_dependency(nlohmann_json CONFIG REQUIRED)
endif()

if (@VIX_CORE_PACKAGE_WITH_TEMPLATE@)
  find_dependency(template CONFIG REQUIRED)
endif()

if (@VIX_CORE_PACKAGE_WITH_UI@)
  find_dependency(ui CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vix_coreTargets.cmake")

check_required_components(vix_core)
